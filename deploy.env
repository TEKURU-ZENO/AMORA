# Non-secret settings for every deployment of this repo (committed on purpose).
# Host env vars and a local .env override these. NEVER put API keys or tokens here.

# Demo mode: an empty pool fills itself with 50 fictional personas and a dating round,
# and discovery uses a fictional provider. Delete this line (or set AMORA_DEMO=0 on the host)
# to run the real, Apify-only pool.
AMORA_DEMO=1
